{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:e2e": "playwright test --project=web --project=mobile-chrome --project=mobile-safari",
    "test:e2e:mobile": "playwright test --project=mobile-chrome --project=mobile-safari",
    "test:e2e:regress": "playwright test --project=web --project=mobile-chrome --project=mobile-safari -g \"@critical|@T01|@T03|@T05|@T07|@T09|@T12|@T13\"",
    "test:e2e:ci": "playwright test --project=web --project=mobile-chrome --project=mobile-safari --project=live"
  },
  "dependencies": {
    "dictionary-en": "^4.0.0",
    "dictionary-en-gb": "^3.0.0",
    "next": "16.2.12",
    "nspell": "^2.1.5",
    "posthog-js": "^1.434.15",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
